# Copy this file to the project-root .env and replace both password placeholders.
# The PostgreSQL URL password must match POSTGRES_PASSWORD.
APP_ENV=development
POSTGRES_PASSWORD=replace_with_a_local_postgres_password
NEO4J_PASSWORD=replace_with_a_local_neo4j_password

DATABASE_URL=postgresql+psycopg://diseasegraph:replace_with_a_local_postgres_password@127.0.0.1:5432/diseasegraph
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Optional for AI mechanism explanations. Keep this key local; never commit it.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash

# This standalone project uses its own Neo4j service and project-specific GraphBuilds.
GRAPH_SOURCE=neo4j
GRAPH_DATA_DIR=experiments/platform_phase_b
KG_PYTHON=
MAX_GRAPH_NODES=200
MAX_GRAPH_DEPTH=2
MAX_UPLOAD_BYTES=250000000
